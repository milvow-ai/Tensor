{
  "name": "harness-farm-console",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome lint && tsc --noEmit && next build",
    "check:fix": "biome check --write",
    "test": "vitest run --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "schema:commands": "uv run farm commands schema --out src/lib/farm/command-schemas.json",
    "schema:sync": "node -e \"const { execSync } = require('child_process'); const fs = require('fs'); const out = execSync('uv run farm registry schema', { encoding: 'utf8', cwd: '..' }); fs.writeFileSync('src/lib/farm/registry-schema.json', out.trim() + '\\n', 'utf8');\"",
    "bundle": "node src/scripts/check-bundle-size.mjs",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/generate-theme-presets.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
