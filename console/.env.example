# Public values only (they reach the browser). Secrets never go in the Console.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>

# supabase (default) reads the real Farm database; fixtures is demo data for local development only and is
# refused when NODE_ENV=production.
FARM_DATA_SOURCE=supabase
