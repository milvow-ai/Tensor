    "title": "SetStrategyPayload",
    "type": "object"
  },
  "set_budget": {
    "additionalProperties": false,
    "properties": {
      "scope": {
        "enum": ["global", "provider", "connection"],
        "title": "Scope",
        "type": "string"
      },
      "monthly_usd": {
        "anyOf": [
          {
            "minimum": 0.0,
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ],
        "title": "Monthly Usd"
      },
      "ref": {
        "anyOf": [
          {
            "maxLength": 63,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Ref"
      },
      "hard_stop": {
        "default": true,
        "title": "Hard Stop",
        "type": "boolean"
      }
    },
    "required": ["scope", "monthly_usd"],
    "title": "SetBudgetPayload",
    "type": "object"
  },
  "add_connection": {
    "$defs": {
      "CommandUnitSpec": {
        "additionalProperties": false,
        "description": "Specification of a consumption unit for a connection.",
        "properties": {
          "limit": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Limit"
          },
          "period": {
            "default": "month",
            "enum": ["minute", "hour", "day", "week", "month", "rolling_5h", "total", "none"],
            "title": "Period",
            "type": "string"
          },
          "anchor": {
            "anyOf": [
              {
                "maximum": 31,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Anchor"
          },
          "charged_on": {
            "default": "attempt",
            "enum": ["attempt", "success", "found"],
            "title": "Charged On",
            "type": "string"
          },
          "unit_cost_usd": {
            "default": 0.0,
            "minimum": 0,
            "title": "Unit Cost Usd",
            "type": "number"
          },
          "estimate_per_call": {
            "default": 1.0,
            "minimum": 0,
            "title": "Estimate Per Call",
            "type": "number"
          }
        },
        "title": "CommandUnitSpec",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "provider_id": {
        "maxLength": 63,
        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
        "title": "Provider Id",
        "type": "string"
      },
      "id": {
        "maxLength": 63,
        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
        "title": "Id",
        "type": "string"
      },
      "auth_ref": {
        "title": "Auth Ref",
        "type": "string"
      },
      "label": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Label"
      },
      "scope": {
        "items": {
          "type": "string"
        },
        "title": "Scope",
        "type": "array"
      },
      "priority": {
        "default": 100,
        "minimum": 0,
        "title": "Priority",
        "type": "integer"
      },
      "strategy": {
        "anyOf": [
          {
            "enum": ["failover", "most_remaining", "round_robin", "parallel_split", "sticky", "fit_check", "pin"],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Strategy"
      },
      "concurrency": {
        "default": 1,
        "minimum": 1,
        "title": "Concurrency",
        "type": "integer"
      },
      "rate_per_min": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Rate Per Min"
      },
      "status": {
        "default": "active",
        "enum": ["active", "paused", "needs_login", "exhausted", "disabled"],
        "title": "Status",
        "type": "string"
      },
      "plan": {
        "additionalProperties": true,
        "title": "Plan",
        "type": "object"
      },
      "meta": {
        "additionalProperties": true,
        "title": "Meta",
        "type": "object"
      },
      "units": {
        "patternProperties": {
          "^[a-z0-9][a-z0-9_-]{0,62}$": {
            "$ref": "#/$defs/CommandUnitSpec"
          }
        },
        "propertyNames": {
          "maxLength": 63
        },
        "title": "Units",
        "type": "object"
      }
    },
    "required": ["provider_id", "id", "auth_ref"],
    "title": "AddConnectionPayload",
    "type": "object"
  },
