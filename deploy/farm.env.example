# /etc/harness-farm/farm.env: settings of the Harness Farm server (no secrets; root:root 0644).
# Read by the systemd units (EnvironmentFile=) and by /usr/local/bin/farm. KEY=value lines only, no quotes.
# The secrets are the owner's .env, copied to FARM_ENV_FILE (user farm, mode 0600) and read by the Farm itself.

# State: CLI logins (ai/<connection>), OAuth token stores (tokens/<connection>), workspaces, logs. Backed up.
FARM_DATA_DIR=/var/lib/harness-farm
FARM_ENV_FILE=/var/lib/harness-farm/secrets.env
FARM_REGISTRY_PATH=/var/lib/harness-farm/registry.yaml

# The Farm listens on loopback only. Tailscale Serve publishes it to the tailnet as https://<host>.<tailnet>.ts.net
# (docs/RUNBOOK-SERVER.md §3); port 8787 is never opened to the internet.
FARM_HTTP_HOST=127.0.0.1
FARM_HTTP_PORT=8787
# What `farm connect` prints for clients (set after `tailscale serve`).
FARM_PUBLIC_URL=https://harness-farm.example.ts.net/mcp

# The AI CLIs live in the farm user's home, where they update themselves as on the PC.
PATH=/var/lib/harness-farm/.local/bin:/usr/local/bin:/usr/bin:/bin
LANG=C.UTF-8

# `farm mcp login` on a server: a fixed redirect port to forward with `ssh -L 8765:localhost:8765`.
FARM_OAUTH_CALLBACK_PORT=8765

# Bifrost (LLM gateway for Hermes): pinned version, cache in the state directory.
BIFROST_VERSION=1.6.3
BIFROST_APP_DIR=/var/lib/harness-farm/bifrost
npm_config_cache=/var/lib/harness-farm/.npm
