[Unit]
Description=Harness Farm watchdog health check (restarts a hung Farm or Bifrost, sends the alert)
After=network-online.target harness-farm.service

[Service]
Type=oneshot
# Root, to restart the units; the alert itself is sent as user farm (the script uses runuser).
EnvironmentFile=/etc/harness-farm/farm.env
ExecStart=/opt/harness-farm/scripts/linux/farm-watchdog.sh

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/harness-farm
