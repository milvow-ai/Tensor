[Unit]
Description=Harness Farm MCP gateway and execution engine
Documentation=file:///opt/harness-farm/docs/RUNBOOK-SERVER.md
After=network-online.target harness-farm-bifrost.service
Wants=network-online.target

[Service]
Type=simple
# Never root: the AI CLIs run as children of this process (Claude Code refuses to skip permissions as root).
User=farm
Group=farm
WorkingDirectory=/opt/harness-farm
EnvironmentFile=/etc/harness-farm/farm.env
ExecStart=/opt/harness-farm/.venv/bin/farm run
# Always: a clean exit of a 24/7 service is a fault too. The watchdog timer catches hangs (/health).
Restart=always
RestartSec=5
# farm run lets in-flight calls finish for up to 30 s, then marks unfinished AI jobs.
TimeoutStopSec=90
StateDirectory=harness-farm
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=65536

# Hardening: everything but the state directory is read-only, /home and /root are hidden.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/harness-farm

[Install]
WantedBy=multi-user.target
