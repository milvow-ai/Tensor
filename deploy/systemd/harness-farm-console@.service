[Unit]
Description=Harness Farm private console %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
User=hfui-%i
Group=hfui-%i
WorkingDirectory=/var/lib/harness-farm-consoles/%i/console
EnvironmentFile=/etc/harness-farm/instances/%i/console.env
EnvironmentFile=-/etc/harness-farm/instances/%i/reporting.env
ExecStart=/opt/harness-farm/scripts/linux/start-console.sh
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
MemoryMax=768M
TasksMax=128
KillMode=control-group
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/harness-farm-consoles/%i

[Install]
WantedBy=multi-user.target
